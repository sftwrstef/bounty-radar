# GitHub API token. In GitHub Actions, the workflow can use github.token, but a
# fine-grained read-only PAT gives better rate limits for larger watchlists.
BOUNTY_RADAR_GITHUB_TOKEN=

# Telegram bot delivery.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# The radar also accepts the existing Vesper notifier aliases:
# AUDIT_TELEGRAM_BOT_TOKEN=
# AUDIT_TELEGRAM_CHAT_ID=
# BOUNTY_RADAR_TELEGRAM_BOT_TOKEN=
# BOUNTY_RADAR_TELEGRAM_CHAT_ID=

# Browser-backed source fetches, used for sources that block plain HTTP clients.
BOUNTY_RADAR_BROWSER_HEADLESS=true
BOUNTY_RADAR_BROWSER_USER_DATA_DIR=data/browser-profile

# Local paths.
TRACKED_CONFIG=tracked_orgs.json
BOUNTY_RADAR_DB=data/bounty_radar.sqlite
DIGEST_DIR=digests

# Set to true for dry local runs that should never send Telegram messages.
DISABLE_TELEGRAM=false
